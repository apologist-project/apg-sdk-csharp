<!--
Configure additional MSBuild properties for your project in this file:
- Step 1: Add this file to your .fernignore file to ensure it is not overwritten.
- Step 2: Modify this file to your liking.
-->
<Project>
  <PropertyGroup>
    <Version>1.0.2</Version>
    <Authors>Apologist</Authors>
    <Company>Apologist</Company>
    <Description>Official .NET client for the Apologist Agent API.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/apologist-project/apg-sdk-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/apologist-project/apg-sdk-csharp</RepositoryUrl>
    <PackageTags>apologist;api;sdk</PackageTags>
  </PropertyGroup>
</Project>
